{
  "name": "founder-os-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Founder OS Kit — React mirror of the full Agentic30 SwiftUI surface (screens + components), built from OpenDesignReferencePages/OpenDesignDayPageView/IntakeV2/etc. + OpenDesignTokens.swift, verified against e2e app screenshots",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/ds.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "dependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
